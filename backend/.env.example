# AgroScan Backend Environment Configuration
PROJECT_NAME="AgroScan API"
VERSION="1.0.0"
SECRET_KEY="replace-with-a-random-value-at-least-32-characters"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Local development only. Render production deployments must set DATABASE_URL to
# the connection URL of a persistent PostgreSQL database.
DATABASE_URL="sqlite:///./agroscan.db"
# DATABASE_URL="postgresql://agroscan:agroscan_pass@db:5432/agroscan_db"

UPLOAD_DIR="./uploads"
STATIC_URL_PREFIX="/uploads"
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,https://smart-crop-disease-detector-1.onrender.com"
SEED_DEMO_DATA=false
MAX_UPLOAD_SIZE_MB=10
MAX_IMAGE_PIXELS=12000000
