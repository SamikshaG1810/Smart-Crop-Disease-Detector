# AgroScan Backend Environment Configuration
PROJECT_NAME="AgroScan API"
VERSION="1.0.0"
SECRET_KEY="replace-with-a-random-value-at-least-32-characters"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database: Default SQLite for easy local dev; can swap to PostgreSQL:
DATABASE_URL="sqlite:///./agroscan.db"
# DATABASE_URL="postgresql://agroscan:agroscan_pass@db:5432/agroscan_db"

UPLOAD_DIR="./uploads"
STATIC_URL_PREFIX="/uploads"
CORS_ORIGINS="http://localhost:3000"
SEED_DEMO_DATA=false
MAX_UPLOAD_SIZE_MB=10
